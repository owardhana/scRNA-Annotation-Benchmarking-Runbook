# Tabular data. The exceptions are configuration and manifests, not data.
*.tsv
*.tsv.gz
*.csv
!/harness/01-data-preparation/preprocessing/datasets.csv
!/as-run/MANIFEST.tsv
!/as-run/upstream/UPSTREAM.tsv
!/reproduce/MANIFEST.tsv

# Upstream files with no licence, restored locally by as-run/fetch_upstream.py.
# They are not redistributed; the pins and patches are in as-run/upstream/.
/as-run/benchmarking/python-DL-implementation/DL-based/scGAD_package/*.py
/as-run/benchmarking/python-DL-implementation/DL-based/scSemiCluster_package/*.py
/as-run/benchmarking/python-DL-implementation/DL-based/scSemiGAN_package/*.py
!/as-run/benchmarking/python-DL-implementation/DL-based/*_package/__init__.py
/as-run/benchmarking/python-DL-implementation/DL-based/run_CIForm_helper.py
/as-run/benchmarking/python-DL-implementation2/run_CIForm_helper.py

